{
  // Cloudflare Workers deployment: the site is static files only (no Worker script).
  // `wrangler deploy` runs the build below first, so the registry, both showcases and the
  // fonts are always built, whatever build command the dashboard is set to.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "react95-ui",
  "compatibility_date": "2026-11-01",
  // R95_SITE is this deployment's address: registry items point at it for their dependencies
  "build": { "command": "R95_SITE=https://react95-ui.hjjam100.workers.dev npm run build:site" },
  "assets": { "directory": "./dist" }
}
